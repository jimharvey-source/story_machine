# Copy to .env.local for local development. Never commit .env.local.
# Set every one of these in Vercel (all three environments) before pushing the paid tier.

# Anthropic. A Workspace key (Default workspace); personal keys are rejected.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase (StoryMachine project, dgaofykwlmlpsbssciyy, schema "story"). Dashboard, Project Settings, API.
NEXT_PUBLIC_SUPABASE_URL=https://dgaofykwlmlpsbssciyy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Product "Jim Harvey's StoryMachine", prices in USD: a story 9.99 (one-off), a month 19.99 and a
# year 149.99 (subscriptions). scripts/stripe-setup.mjs makes them; the app finds them by lookup key.
# The STRIPE_PRICE_* variables are written by the script, and are the fallback if the lookup fails.
STRIPE_SECRET_KEY=
STRIPE_PRICE_STORY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Webhook endpoint https://storymachine.themessagebusiness.com/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.created, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# Where Stripe and the magic link send people back to.
NEXT_PUBLIC_SITE_URL=https://storymachine.themessagebusiness.com

# Mailchimp (Presentation Guru list). Optional: without them nobody is added to the list.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
