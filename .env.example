# Copy to .env.local for local development. Never commit .env.local.
# Set every one of these in Vercel (all three environments) before pushing the paid tier.

# Anthropic. A Workspace key (Default workspace); personal keys are rejected.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase (OSCI project, schema "story"). Dashboard, Project Settings, API.
NEXT_PUBLIC_SUPABASE_URL=https://fdiitxhgfytvlbtokbok.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Product "Story Machine" with three prices in USD (CURRENCY=gbp for sterling):
#   one story 2.99 (one-off), a month 15.99 (recurring monthly), lifetime 99 (one-off).
# Launch offer: a coupon on the lifetime price, first 500, redeemable at checkout.
STRIPE_SECRET_KEY=
STRIPE_PRICE_STORY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_LIFETIME=
# Webhook endpoint https://storymachine.themessagebusiness.com/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.created, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# Where Stripe and the magic link send people back to.
NEXT_PUBLIC_SITE_URL=https://storymachine.themessagebusiness.com

# Mailchimp (Presentation Guru list). Optional: without them nobody is added to the list.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
